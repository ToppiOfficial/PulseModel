// Win32 version resource - generated by CMake from the project() version.
1 VERSIONINFO
FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS         0x4L        // VOS__WINDOWS32
FILETYPE       0x1L        // VFT_APP
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"   // US English, Unicode
        {
            VALUE "FileDescription",  ""
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "pulsemdl2"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Toppi - MIT License"
            VALUE "OriginalFilename", "pulsemdl2.exe"
            VALUE "ProductName",      "PulseMDL2"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1200
    }
}
