// Win32 version resource - generated by CMake from TOOL_VERSION.
1 VERSIONINFO
FILEVERSION    @TOOL_VERSION_COMMA@,0
PRODUCTVERSION @TOOL_VERSION_COMMA@,0
FILEOS         0x4L        // VOS__WINDOWS32
FILETYPE       0x1L        // VFT_APP
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"   // US English, Unicode
        {
            VALUE "FileDescription",  "Source model decompiler (.mdl -> .pulseqc)"
            VALUE "FileVersion",      "@TOOL_VERSION@"
            VALUE "InternalName",     "mdldecompiler"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Toppi - MIT License"
            VALUE "OriginalFilename", "mdldecompiler.exe"
            VALUE "ProductName",      "PulseModel"
            VALUE "ProductVersion",   "@TOOL_VERSION@"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1200
    }
}
